<div class="container py-4">

  <!-- ── Cabecera ───────────────────────────────────────────────────────── -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h2 class="fw-bold mb-0">
        <i class="bi bi-calendar-heart-fill me-2" style="color:var(--mb-primary);"></i>Mi Calendario
      </h2>
      <span class="text-muted">{{cycles.length}} ciclo(s) registrado(s)</span>
    </div>
    <div class="d-flex gap-2">
      <a href="/ciclos/nuevo" class="btn btn-moon rounded-3">
        <i class="bi bi-plus-circle-fill me-1"></i>Nuevo ciclo
      </a>
      <a href="/dashboard" class="btn btn-outline-secondary rounded-3">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
      </a>
    </div>
  </div>

  {{#if cycles.length}}
  <!-- ── Timeline de ciclos ─────────────────────────────────────────────── -->
  <div class="cycles-timeline">
    {{#each cycles}}
    <div class="cycle-entry mb-card mb-3">
      <div class="cycle-entry-header">
        <div class="cycle-number">
          <i class="bi bi-circle-fill" style="color:var(--mb-primary); font-size:0.6rem;"></i>
          Ciclo
        </div>
        <div class="d-flex align-items-center gap-2">
          {{#if this.durationDays}}
          <span class="badge-cycle">{{this.durationDays}} días</span>
          {{/if}}
          <a href="/ciclos/{{this._id}}/editar" class="btn btn-sm btn-outline-secondary rounded-3">
            <i class="bi bi-pencil-fill me-1"></i>Editar
          </a>
          <form action="/ciclos/{{this._id}}/eliminar" method="POST" class="d-inline"
            onsubmit="return confirm('¿Eliminar este ciclo? Esta acción no se puede deshacer.')">
            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
              <i class="bi bi-trash-fill me-1"></i>Eliminar
            </button>
          </form>
        </div>
      </div>
      <div class="cycle-entry-body mt-2">
        <div class="row g-3">
          <div class="col-sm-4">
            <div class="cycle-info-item">
              <span class="ci-label"><i class="bi bi-play-circle me-1"></i>Inicio</span>
              <span class="ci-value">{{formatDate this.startDate}}</span>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="cycle-info-item">
              <span class="ci-label"><i class="bi bi-stop-circle me-1"></i>Fin</span>
              <span class="ci-value">
                {{#if this.endDate}}{{formatDate this.endDate}}{{else}}<em>En curso</em>{{/if}}
              </span>
            </div>
          </div>
          {{#if this.notes}}
          <div class="col-sm-4">
            <div class="cycle-info-item">
              <span class="ci-label"><i class="bi bi-chat-left-text me-1"></i>Notas</span>
              <span class="ci-value">{{this.notes}}</span>
            </div>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  {{else}}
  <!-- ── Empty state ────────────────────────────────────────────────────── -->
  <div class="mb-card empty-state">
    <span class="empty-icon">📅</span>
    <h5 class="fw-semibold mb-1">No tienes ciclos registrados</h5>
    <p class="text-muted mb-3">Registra tu primer ciclo para empezar a llevar tu seguimiento.</p>
    <a href="/ciclos/nuevo" class="btn btn-moon">
      <i class="bi bi-plus-circle-fill me-1"></i>Crear mi primer ciclo
    </a>
  </div>
  {{/if}}

</div>
