<div class="auth-wrapper">
  <div class="auth-card">
    <div class="text-center mb-4">
      <span class="auth-logo">🌸</span>
      <h2 class="fw-bold mt-2 mb-0">Bienvenida de nuevo</h2>
      <p class="text-muted">Inicia sesión en MoonBloom</p>
    </div>

    {{#if error}}
    <div class="alert alert-danger border-0 rounded-3 py-2" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>{{error}}
    </div>
    {{/if}}

    <form action="/login" method="POST" class="mb-form" novalidate>
      <div class="mb-3">
        <label for="email" class="form-label">Correo electrónico</label>
        <div class="input-group-icon">
          <i class="bi bi-envelope-fill field-icon"></i>
          <input type="email" id="email" name="email" class="form-control ps-5"
            placeholder="luna@ejemplo.com" required />
        </div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label">Contraseña</label>
        <div class="input-group-icon">
          <i class="bi bi-lock-fill field-icon"></i>
          <input type="password" id="password" name="password" class="form-control ps-5"
            placeholder="Tu contraseña" required />
        </div>
      </div>

      <button type="submit" class="btn btn-moon w-100 py-2 fs-6 mb-3">
        <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
      </button>
    </form>

    <div class="text-center text-muted my-3" style="font-size:.85rem;">o</div>

    <a href="/api/auth/google" class="btn btn-outline-secondary w-100 py-2 fs-6 d-flex align-items-center justify-content-center">
      <svg width="18" height="18" viewBox="0 0 18 18" class="me-2">
        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.47-.81 5.96-2.18l-2.92-2.26c-.8.54-1.83.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.97 10.71A5.41 5.41 0 0 1 3.68 9c0-.59.1-1.17.29-1.71V4.96H.96A9 9 0 0 0 0 9c0 1.45.35 2.82.96 4.04l3.01-2.33z"/>
        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.96L3.97 7.3C4.68 5.16 6.66 3.58 9 3.58z"/>
      </svg>
      Continuar con Google
    </a>

    <p class="text-center text-muted mt-4 mb-0">
      ¿No tienes cuenta?
      <a href="/registro" class="fw-semibold text-decoration-none" style="color:var(--mb-primary);">Regístrate</a>
    </p>
  </div>
</div>