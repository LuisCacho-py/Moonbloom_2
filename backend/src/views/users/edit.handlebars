<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">

      {{#if isSelf}}
      <a href="/dashboard" class="text-decoration-none d-inline-flex align-items-center mb-3" style="color:var(--mb-muted);">
        <i class="bi bi-arrow-left me-1"></i>Volver al dashboard
      </a>
      {{else}}
      <a href="/usuarios" class="text-decoration-none d-inline-flex align-items-center mb-3" style="color:var(--mb-muted);">
        <i class="bi bi-arrow-left me-1"></i>Volver a usuarias
      </a>
      {{/if}}

      <div class="mb-card">
        <h2 class="fw-bold mb-1">
          <i class="bi bi-person-gear me-2" style="color:var(--mb-primary);"></i>
          {{#if isSelf}}Mi perfil{{else}}Editar usuaria{{/if}}
        </h2>
        <p class="text-muted mb-4">Modifica los datos de esta cuenta</p>

        {{#if error}}
        <div class="alert alert-danger border-0 rounded-3 py-2">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>{{error}}
        </div>
        {{/if}}

        <form action="/usuarios/{{user.idStr}}/editar" method="POST" class="mb-form" autocomplete="off">

          <div class="mb-3">
            <label for="name" class="form-label">Nombre completo</label>
            <div class="input-group-icon">
              <i class="bi bi-person-fill field-icon"></i>
              <input type="text" id="name" name="name" class="form-control ps-5"
                value="{{user.name}}" required />
            </div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Correo electrónico</label>
            <div class="input-group-icon">
              <i class="bi bi-envelope-fill field-icon"></i>
              <input type="email" id="email" name="email" class="form-control ps-5"
                value="{{user.email}}" required autocomplete="off" />
            </div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">
              Nueva contraseña
              <span class="text-muted fw-normal">(dejar vacío para no cambiarla)</span>
            </label>
            <div class="input-group-icon">
              <i class="bi bi-lock-fill field-icon"></i>
              <input type="password" id="password" name="password" class="form-control ps-5"
                minlength="6" autocomplete="new-password" />
            </div>
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-moon py-2 fs-6">
              <i class="bi bi-check-circle-fill me-2"></i>Guardar cambios
            </button>
          </div>
        </form>

        {{#if isSelf}}
        <hr class="my-4" />
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <p class="fw-semibold mb-0 text-danger">Zona de peligro</p>
            <small class="text-muted">Esta acción eliminará tu cuenta permanentemente.</small>
          </div>
          <form action="/usuarios/{{user.idStr}}/eliminar" method="POST"
            onsubmit="return confirm('¿Eliminar tu cuenta? Esta acción no se puede deshacer.')">
            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3">
              <i class="bi bi-trash-fill me-1"></i>Eliminar cuenta
            </button>
          </form>
        </div>
        {{/if}}

      </div>

    </div>
  </div>
</div>
