<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MoonBloom 🌸</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- ── Navbar ─────────────────────────────────────────────────────────── -->
  <nav class="navbar navbar-expand-lg navbar-dark" id="main-navbar">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">🌸 MoonBloom</a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMenu">
        {{#if user}}
        <!-- Usuaria logueada -->
        <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
          <li class="nav-item">
            <a class="nav-link" href="/dashboard"><i class="bi bi-grid-fill me-1"></i>Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/calendario"><i class="bi bi-calendar-heart-fill me-1"></i>Mi Calendario</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/registros"><i class="bi bi-journal-richtext me-1"></i>Registros Diarios</a>
          </li>
          {{#if (eq user.role "admin")}}
          <li class="nav-item">
            <a class="nav-link" href="/usuarios"><i class="bi bi-people-fill me-1"></i>Usuarias</a>
          </li>
          {{/if}}
          <li class="nav-item ms-lg-2">
            <a class="nav-link text-light opacity-75 d-none d-lg-block" href="/perfil">
              <i class="bi bi-person-circle me-1"></i>{{user.name}}
            </a>
          </li>
          <li class="nav-item">
            <a class="btn btn-outline-light btn-sm px-3" href="/logout">
              <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
          </li>
        </ul>
        {{else}}
        <!-- No logueada -->
        <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
          <li class="nav-item">
            <a class="nav-link" href="/"><i class="bi bi-house-fill me-1"></i>Inicio</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión</a>
          </li>
          <li class="nav-item ms-lg-1">
            <a class="btn btn-light btn-sm text-mb-primary fw-semibold px-3" href="/registro" style="color:var(--mb-primary);">
              <i class="bi bi-person-plus me-1"></i>Registrarse
            </a>
          </li>
        </ul>
        {{/if}}
      </div>
    </div>
  </nav>

  <!-- ── Contenido dinámico ─────────────────────────────────────────────── -->
  <main class="pb-5">
    {{{body}}}
  </main>

  <!-- ── Footer ─────────────────────────────────────────────────────────── -->
  <footer id="main-footer" class="text-center py-4 mt-5">
    <small>🌸 MoonBloom &mdash; Seguimiento del Ciclo y Bienestar &copy; 2025</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
