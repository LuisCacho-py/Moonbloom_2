                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }]
          }
        },
        {
          "name": "Obtener registro por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
